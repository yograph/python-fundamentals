# Copy to .env and fill in. Nothing here is needed to run the app — only to
# regenerate pronunciation audio, which the deployed site never does.

# Google AI Studio key used by tools/audio-gen (pnpm data:audio).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where the frontend loads decks and audio from. Defaults to same-origin "/data",
# which is correct for both `pnpm dev` and the deployed site. Override only to
# point a local build at data hosted somewhere else.
# VITE_DATA_BASE_URL=/data
